              "face",
              "all"
            ]
          },
          "distance_A": {
            "type": "number",
            "minimum": 0
          },
          "operation": {
            "type": "string",
            "description": "Space-group operation with translation part in [0,1), fractional frame"
          },
          "lattice_translation": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Integer lattice vector n applied after operation"
          },
          "image_operation": {
            "type": "string",
            "description": "operation + lattice_translation; the target (or second residue) image"
          },
          "residue1": {
