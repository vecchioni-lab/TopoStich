              "residue",
              "atom",
              "altloc",
              "serial",
              "label_asym",
              "label_seq",
              "description",
              "segment"
            ],
            "properties": {
              "chain": {
                "type": "string"
              },
              "seq": {
                "type": "string"
              },
              "insertion": {
                "type": "string"
              },
              "residue": {
                "type": "string"
              },
              "atom": {
                "type": "string"
              },
              "altloc": {
                "type": "string"
              },
              "serial": {
                "type": "string"
              },
              "label_asym": {
                "type": "string"
              },
              "label_seq": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "segment": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "p_atom": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chain",
              "seq",
              "insertion",
              "residue",
              "atom",
              "altloc",
              "serial",
              "label_asym",
              "label_seq",
              "description",
              "segment"
            ],
            "properties": {
              "chain": {
                "type": "string"
              },
              "seq": {
                "type": "string"
              },
              "insertion": {
                "type": "string"
              },
              "residue": {
                "type": "string"
              },
              "atom": {
