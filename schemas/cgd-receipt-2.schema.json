              "insertion",
              "residue",
              "atom",
              "altloc",
              "serial",
              "label_asym",
              "label_seq",
              "description",
              "segment"
            ],
            "properties": {
              "chain": {
                "type": "string"
              },
              "seq": {
                "type": "string"
              },
              "insertion": {
                "type": "string"
              },
              "residue": {
                "type": "string"
              },
              "atom": {
