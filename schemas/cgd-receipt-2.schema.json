                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "segment": {
                "type": "integer",
                "minimum": 1
              }
            },
            "description": "5' endpoint atom: P, or O5' for the missing-phosphate fallback"
          },
          "source": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^S[0-9]+_N[1-9][0-9]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^S[0-9]+_N[1-9][0-9]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
