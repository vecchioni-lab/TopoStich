                "type": "string"
              },
              "label_seq": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "segment": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "p_atom": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chain",
