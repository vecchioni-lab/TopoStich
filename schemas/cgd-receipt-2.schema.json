                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "segment": {
                "type": "integer",
                "minimum": 1
              }
            },
            "description": "First residue, stored position"
          },
          "residue2": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chain",
              "seq",
              "insertion",
              "residue",
              "label_asym",
              "label_seq",
              "description",
              "segment"
            ],
            "properties": {
              "chain": {
                "type": "string"
              },
              "seq": {
                "type": "string"
              },
              "insertion": {
                "type": "string"
              },
              "residue": {
                "type": "string"
              },
              "label_asym": {
                "type": "string"
              },
              "label_seq": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "segment": {
                "type": "integer",
                "minimum": 1
              }
            },
            "description": "Second residue, in image_operation"
