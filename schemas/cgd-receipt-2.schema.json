              },
              "label_seq": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "segment": {
                "type": "integer",
                "minimum": 1
              },
              "end": {
                "enum": [
                  "5'",
                  "3'"
                ]
              }
            },
            "description": "First chain end, stored position (the 3' end of a 5'-3' stack)"
          },
          "residue2": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chain",
              "seq",
              "insertion",
              "residue",
              "label_asym",
              "label_seq",
              "description",
              "segment",
              "end"
