    "junction_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "status",
          "method",
          "reason",
          "scope",
          "distance_A",
          "operation",
          "lattice_translation",
          "image_operation",
          "residue1",
          "residue2",
          "source",
          "target",
          "measurements",
          "backbone_context"
        ],
        "properties": {
          "kind": {
            "const": "junction_stack"
          },
          "status": {
            "enum": [
              "stitched",
              "not_face_junction",
              "no_graph_node",
              "duplicate_edge"
            ]
          },
          "method": {
            "type": "string"
